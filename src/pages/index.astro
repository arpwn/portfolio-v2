---
import "../styles/global.css";
import { CommandMenu } from "@/components/CommandMenu";
import BreadcrumbDemo from "@/components/BreadcrumbDemo";
import HeaderRow from "@/components/HeaderRow";
import SeasonalHeader from "@/components/SeasonalHeader";
import SeasonalHeaderPro from "@/components/SeasonalHeaderPro";
import TextPager from "@/components/TextPager";
import DotBackgroundBg from "@/components/DotBackgroundBg";
import { ModeToggle } from "@/components/ModeToggle";
import LanguageToggle from "@/components/LanguageToggle";
---

<!-- Preferencias iniciales: idioma + tema -->
<script is:inline>
  // Idioma inicial (localStorage -> navigator)
  (function () {
    try {
      const saved = localStorage.getItem('lang');
      const lang = (saved === 'en' || saved === 'es')
        ? saved
        : (navigator.language || '').toLowerCase().startsWith('es') ? 'es' : 'en';
      document.documentElement.setAttribute('lang', lang);
    } catch {}
  })();

  // Tema inicial (localStorage -> prefers-color-scheme)
  (function () {
    const getThemePreference = () => {
      try {
        const saved = localStorage.getItem('theme');
        if (saved) return saved;
      } catch {}
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    };
    const isDark = getThemePreference() === 'dark';
    document.documentElement.classList[isDark ? 'add' : 'remove']('dark');

    // Observa cambios para persistir
    try {
      const observer = new MutationObserver(() => {
        const isDarkNow = document.documentElement.classList.contains('dark');
        localStorage.setItem('theme', isDarkNow ? 'dark' : 'light');
      });
      observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    } catch {}
  })();
</script>

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Armando — Front-End Developer</title>
  </head>

  <body class="min-h-screen relative pb-24 bg-white text-black dark:bg-black dark:text-white">
    <!-- Fondo -->
    <DotBackgroundBg client:only="react" />

    <!-- Command Palette (⌘/Ctrl + K) -->
    <CommandMenu client:only="react" />

    <!-- Top bar: breadcrumb + toggles -->
    <div class="flex items-center justify-between px-12 mt-4 gap-2">
      <BreadcrumbDemo client:only="react" />
      <div class="flex items-center gap-2">
        <LanguageToggle client:only="react" />
        <ModeToggle client:load />
      </div>
    </div>

    <!-- Header con avatar + nombre -->
    <!-- <HeaderRow client:only="react" /> -->

    <!-- <SeasonalHeader client:only="react" /> -->

    <SeasonalHeaderPro client:only="react" />

    <h1 class="mx-12 mt-10 text-4xl md:text-5xl font-bold
           bg-gradient-to-r from-indigo-400 via-purple-400 to-pink-400
           bg-clip-text text-transparent
           transition-all duration-300 hover:tracking-wide">
      Front-End Developer
    </h1>

    <p
      id="hero-sub"
      class="mx-12 mt-2 text-muted-foreground text-lg max-w-xl"
    >

    <p class="mx-12 mt-3 text-sm text-muted-foreground tracking-wide">
      React · Angular · TypeScript
    </p>

    <p class="mx-12 mt-6 text-base" id="hero-sub"></p>

    <!-- Contenido paginado: Inicio / Proyectos / Contacto -->
    <TextPager client:only="react" />

    <!-- Botón flotante para abrir Command -->
    <button
      class="fixed bottom-4 right-4 rounded-md border px-3 py-2 text-sm hover:bg-muted/50"
      onclick="window.dispatchEvent(new Event('command:open'))">
      Search (⌘/Ctrl + K)
    </button>

<script is:inline>
  (function () {
    const dict = {
      es: "Desarrollo interfaces modernas con foco en claridad, eficiencia y código mantenible.",
      en: "I build modern interfaces focused on clarity, efficiency, and maintainable code."
    };

    const el = document.getElementById("hero-sub");
    if (!el) return;

    function getLang() {
      try {
        const saved = localStorage.getItem("lang");
        if (saved === "es" || saved === "en") return saved;
      } catch {}
      return (navigator.language || "").startsWith("es") ? "es" : "en";
    }

    function apply(lang) {
      el.textContent = dict[lang] || dict.es;
    }

    // inicial
    apply(getLang());

    // escuchar cambios
    window.addEventListener("lang:changed", (e) => {
      apply(e?.detail?.lang || getLang());
    });
  })();
</script>
  </body>
</html>
